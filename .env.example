# 复制为 .env 后填入，Inspect 会自动读取（.env 已在 .gitignore 里，不会被提交）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 默认被测模型，设置后运行时可以省略 --model
# INSPECT_EVAL_MODEL=anthropic/claude-sonnet-5-5

# 兼容 OpenAI 接口的模型（如 DeepSeek），模型名写成 openai-api/deepseek/deepseek-chat
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
